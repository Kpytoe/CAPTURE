<?xml version="1.0" encoding="utf-8"?>
<!--
  Un solo CapturaLocal.exe que funciona en cualquier Windows 10/11 de 64 bits sin instalar .NET.
  Ver ADR-007 en docs\DECISIONS.md.

    dotnet publish src\CapturaLocal\CapturaLocal.csproj -p:PublishProfile=Portable

  Sale en artifacts\portable\CapturaLocal.exe (ignorado por git).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Lleva el runtime dentro: quien lo descarga no necesita tener .NET instalado. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF trae DLL nativas (wpfgfx, PresentationNative...). Sin esto quedarían sueltas junto al exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Sin .pdb al lado: el usuario recibe un archivo, no dos. -->
    <DebugType>none</DebugType>
    <!-- WPF no admite recorte (trimming): se queda desactivado a propósito. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\portable\</PublishDir>
  </PropertyGroup>
</Project>
