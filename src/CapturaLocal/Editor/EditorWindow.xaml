<Window x:Class="CapturaLocal.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captura Local"
        Icon="/Assets/app.ico"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource PincelLienzo}">

    <DockPanel>

        <!-- Barra de herramientas -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PincelSuperficie}"
                BorderBrush="{StaticResource PincelBorde}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>

                <!-- Deshacer y rehacer viven a la derecha: son historial, no herramientas. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource AccionIcono}"
                            Click="Undo_Click" ToolTip="Deshacer (Ctrl+Z)"
                            AutomationProperties.Name="Deshacer">
                        <Path Style="{StaticResource IconoAccion}"
                              Data="{StaticResource IconoDeshacer}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource AccionIcono}"
                            Click="Redo_Click" ToolTip="Rehacer (Ctrl+Y)"
                            AutomationProperties.Name="Rehacer">
                        <Path Style="{StaticResource IconoAccion}"
                              Data="{StaticResource IconoRehacer}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">

                    <ToggleButton x:Name="ToolSelect" Style="{StaticResource Herramienta}"
                                  Click="Tool_Click" Tag="Select"
                                  ToolTip="Seleccionar una marca para moverla o borrarla (S)"
                                  AutomationProperties.Name="Herramienta seleccionar">
                        <StackPanel>
                            <Path Style="{StaticResource IconoHerramienta}"
                                  Data="{StaticResource IconoSeleccionar}" />
                            <TextBlock Style="{StaticResource EtiquetaHerramienta}"
                                       Text="Seleccionar" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="ToolPencil" Style="{StaticResource Herramienta}"
                                  Click="Tool_Click" Tag="Pencil" IsChecked="True"
                                  ToolTip="Dibujo libre (L)"
                                  AutomationProperties.Name="Herramienta lápiz">
                        <StackPanel>
                            <Path Style="{StaticResource IconoHerramienta}"
                                  Data="{StaticResource IconoLapiz}" />
                            <TextBlock Style="{StaticResource EtiquetaHerramienta}" Text="Lápiz" />
                        </StackPanel>
                    </ToggleButton>

                    <!--
                      Figuras: un boton que activa la figura vigente y, pegada a el, una flecha
                      que abre el menu para cambiarla. Icono, etiqueta y Tag del primero los
                      actualiza ShowShape en el codigo.
                    -->
                    <ToggleButton x:Name="ToolShape" Style="{StaticResource Herramienta}"
                                  Click="Tool_Click" Tag="Rectangle"
                                  ToolTip="Figura: rectángulo (R), círculo (C) o línea (N). Con Mayús: cuadrado, círculo perfecto o línea a 45°"
                                  AutomationProperties.Name="Herramienta rectángulo">
                        <StackPanel>
                            <Path x:Name="ShapeIcon" Style="{StaticResource IconoHerramienta}"
                                  Data="{StaticResource IconoRectangulo}" />
                            <TextBlock x:Name="ShapeLabel" Style="{StaticResource EtiquetaHerramienta}"
                                       Text="Rectángulo" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="ShapeMenuButton" Style="{StaticResource Herramienta}"
                                  Width="16" Margin="-2,0,2,0"
                                  Click="ShapeMenu_Click"
                                  ToolTip="Elegir figura"
                                  AutomationProperties.Name="Elegir figura">
                        <Path Style="{StaticResource IconoHerramienta}" Width="8" Height="8"
                              Data="{StaticResource IconoDesplegar}" />
                    </ToggleButton>

                    <Popup x:Name="ShapePopup" PlacementTarget="{Binding ElementName=ToolShape}"
                           Placement="Bottom" VerticalOffset="4"
                           StaysOpen="False" AllowsTransparency="True"
                           Opened="ShapePopup_Opened" Closed="ShapePopup_Closed">
                        <Border Background="{StaticResource PincelSuperficie}"
                                BorderBrush="{StaticResource PincelBorde}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ShapeRectangle" Style="{StaticResource Herramienta}"
                                              Click="ShapeOption_Click" Tag="Rectangle"
                                              ToolTip="Rectángulo (R)"
                                              AutomationProperties.Name="Rectángulo">
                                    <StackPanel>
                                        <Path Style="{StaticResource IconoHerramienta}"
                                              Data="{StaticResource IconoRectangulo}" />
                                        <TextBlock Style="{StaticResource EtiquetaHerramienta}"
                                                   Text="Rectángulo" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ShapeEllipse" Style="{StaticResource Herramienta}"
                                              Click="ShapeOption_Click" Tag="Ellipse"
                                              ToolTip="Círculo o elipse (C)"
                                              AutomationProperties.Name="Círculo">
                                    <StackPanel>
                                        <Path Style="{StaticResource IconoHerramienta}"
                                              Data="{StaticResource IconoElipse}" />
                                        <TextBlock Style="{StaticResource EtiquetaHerramienta}"
                                                   Text="Círculo" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton x:Name="ShapeLine" Style="{StaticResource Herramienta}"
                                              Click="ShapeOption_Click" Tag="Line"
                                              ToolTip="Línea recta (N)"
                                              AutomationProperties.Name="Línea recta">
                                    <StackPanel>
                                        <Path Style="{StaticResource IconoHerramienta}"
                                              Data="{StaticResource IconoLinea}" />
                                        <TextBlock Style="{StaticResource EtiquetaHerramienta}"
                                                   Text="Línea" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton x:Name="ToolText" Style="{StaticResource Herramienta}"
                                  Click="Tool_Click" Tag="Text"
                                  ToolTip="Insertar texto (T)"
                                  AutomationProperties.Name="Herramienta texto">
                        <StackPanel>
                            <Path Style="{StaticResource IconoHerramienta}"
                                  Data="{StaticResource IconoTexto}" />
                            <TextBlock Style="{StaticResource EtiquetaHerramienta}" Text="Texto" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="ToolPixelate" Style="{StaticResource Herramienta}"
                                  Click="Tool_Click" Tag="Pixelate"
                                  ToolTip="Tapar información sensible (P)"
                                  AutomationProperties.Name="Herramienta pixelar">
                        <StackPanel>
                            <Path Style="{StaticResource IconoHerramienta}"
                                  Data="{StaticResource IconoPixelar}" />
                            <TextBlock Style="{StaticResource EtiquetaHerramienta}" Text="Pixelar" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Style="{StaticResource Divisor}" />

                    <!-- Las muestras se generan en el constructor a partir de Colores y Grosores. -->
                    <TextBlock Style="{StaticResource EtiquetaBarra}" Text="Color" />
                    <StackPanel x:Name="ColorSwatches" Orientation="Horizontal"
                                VerticalAlignment="Center" />

                    <Border Style="{StaticResource Divisor}" />

                    <TextBlock x:Name="ThicknessLabel" Style="{StaticResource EtiquetaBarra}"
                               Text="Grosor" />
                    <StackPanel x:Name="ThicknessSwatches" Orientation="Horizontal"
                                VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra inferior -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PincelSuperficie}"
                BorderBrush="{StaticResource PincelBorde}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource EtiquetaBarra}"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <Button x:Name="OpenFolderButton" Style="{StaticResource AccionEnlace}"
                            Content="Abrir carpeta" Visibility="Collapsed"
                            Click="OpenFolder_Click"
                            ToolTip="Mostrar la captura guardada en el explorador"
                            AutomationProperties.Name="Abrir la carpeta de guardado" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AccionFantasma}" Content="Cancelar"
                            Click="Cancel_Click" ToolTip="Descartar la captura (Esc)"
                            AutomationProperties.Name="Descartar la captura" />
                    <Button Style="{StaticResource AccionSecundaria}" Content="Copiar"
                            Click="Copy_Click" ToolTip="Copiar al portapapeles (Ctrl+C)"
                            AutomationProperties.Name="Copiar al portapapeles" />
                    <Button Style="{StaticResource AccionPrimaria}" Content="Guardar"
                            IsDefault="True"
                            Click="Save_Click" ToolTip="Guardar en la carpeta configurada (Ctrl+S)"
                            AutomationProperties.Name="Guardar" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lienzo -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource PincelLienzo}"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="24">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <!-- AnnotationCanvas y el cuadro de texto se insertan en tiempo de ejecución -->
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
