<Window x:Class="CapturaLocal.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captura Local"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="Herramienta" TargetType="ToggleButton">
            <Setter Property="Width" Value="86" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="Accion" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Barra de herramientas -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10,8">
            <StackPanel Orientation="Horizontal">

                <ToggleButton x:Name="ToolSelect" Style="{StaticResource Herramienta}"
                              Content="Seleccionar" Click="Tool_Click" Tag="Select"
                              ToolTip="Seleccionar una marca para moverla o borrarla (S)"
                              AutomationProperties.Name="Herramienta seleccionar" />
                <ToggleButton x:Name="ToolPencil" Style="{StaticResource Herramienta}"
                              Content="Lápiz" Click="Tool_Click" Tag="Pencil" IsChecked="True"
                              ToolTip="Dibujo libre (L)"
                              AutomationProperties.Name="Herramienta lápiz" />
                <ToggleButton x:Name="ToolRectangle" Style="{StaticResource Herramienta}"
                              Content="Rectángulo" Click="Tool_Click" Tag="Rectangle"
                              ToolTip="Rectángulo (R)"
                              AutomationProperties.Name="Herramienta rectángulo" />
                <ToggleButton x:Name="ToolText" Style="{StaticResource Herramienta}"
                              Content="Texto" Click="Tool_Click" Tag="Text"
                              ToolTip="Insertar texto (T)"
                              AutomationProperties.Name="Herramienta texto" />
                <ToggleButton x:Name="ToolPixelate" Style="{StaticResource Herramienta}"
                              Content="Pixelar" Click="Tool_Click" Tag="Pixelate"
                              ToolTip="Tapar información sensible (P)"
                              AutomationProperties.Name="Herramienta pixelar" />

                <Separator Margin="8,0" />

                <TextBlock Text="Color" Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ColorPicker" Width="110" SelectionChanged="Color_Changed"
                          AutomationProperties.Name="Color de la marca" />

                <TextBlock Text="Grosor" Foreground="#DDD" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="ThicknessPicker" Width="70" SelectionChanged="Thickness_Changed"
                          AutomationProperties.Name="Grosor de la marca" />

                <Separator Margin="8,0" />

                <Button x:Name="UndoButton" Style="{StaticResource Accion}" Content="Deshacer"
                        Click="Undo_Click" ToolTip="Deshacer (Ctrl+Z)"
                        AutomationProperties.Name="Deshacer" />
                <Button x:Name="RedoButton" Style="{StaticResource Accion}" Content="Rehacer"
                        Click="Redo_Click" ToolTip="Rehacer (Ctrl+Y)"
                        AutomationProperties.Name="Rehacer" />
            </StackPanel>
        </Border>

        <!-- Barra inferior -->
        <Border DockPanel.Dock="Bottom" Background="#2D2D30" Padding="10,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" Foreground="#AAA" VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Accion}" Content="Cancelar"
                            Click="Cancel_Click" ToolTip="Descartar la captura (Esc)"
                            AutomationProperties.Name="Descartar la captura" />
                    <Button Style="{StaticResource Accion}" Content="Copiar"
                            Click="Copy_Click" ToolTip="Copiar al portapapeles (Ctrl+C)"
                            AutomationProperties.Name="Copiar al portapapeles" />
                    <Button Style="{StaticResource Accion}" Content="Guardar" IsDefault="True"
                            Click="Save_Click" ToolTip="Guardar en la carpeta configurada (Ctrl+S)"
                            AutomationProperties.Name="Guardar" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lienzo -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#181818" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="20">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <!-- AnnotationCanvas y el cuadro de texto se insertan en tiempo de ejecución -->
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
