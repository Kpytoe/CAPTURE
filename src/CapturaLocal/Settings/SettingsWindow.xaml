<Window x:Class="CapturaLocal.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Captura Local"
        Icon="/Assets/app.ico"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource PincelSuperficie}"
        Foreground="{StaticResource PincelTexto}">

    <StackPanel Margin="24">

        <!-- Atajo -->
        <TextBlock Style="{StaticResource TituloSeccion}" Text="Atajo para capturar" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HotkeyBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                     AutomationProperties.Name="Combinación de teclas para capturar"
                     AutomationProperties.HelpText="Pon el foco aquí y pulsa la combinación deseada." />
            <Button x:Name="ResetHotkeyButton"
                    Grid.Column="1" Style="{StaticResource AccionSecundaria}"
                    Content="Predeterminado"
                    Click="ResetHotkey_Click"
                    AutomationProperties.Name="Restaurar el atajo predeterminado" />
        </Grid>
        <TextBlock x:Name="HotkeyHelp" Style="{StaticResource TextoAyuda}"
                   Text="Pon el foco en el cuadro y pulsa la combinación que quieras." />
        <TextBlock x:Name="HotkeyWarning" Style="{StaticResource TextoAyuda}"
                   Foreground="{StaticResource PincelAviso}" Visibility="Collapsed" />

        <Border Style="{StaticResource DivisorHorizontal}" />

        <!-- Carpeta -->
        <TextBlock Style="{StaticResource TituloSeccion}" Text="Carpeta de guardado" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Grid.Column="0"
                     TextChanged="FolderBox_TextChanged"
                     AutomationProperties.Name="Ruta de la carpeta de guardado" />
            <Button Grid.Column="1" Style="{StaticResource AccionSecundaria}"
                    Content="Examinar…"
                    Click="Browse_Click"
                    AutomationProperties.Name="Elegir carpeta de guardado" />
        </Grid>
        <TextBlock x:Name="FolderWarning" Style="{StaticResource TextoAyuda}"
                   Foreground="{StaticResource PincelAviso}" Visibility="Collapsed" />

        <Border Style="{StaticResource DivisorHorizontal}" />

        <!-- Registro -->
        <CheckBox x:Name="LoggingCheck"
                  Content="Guardar un registro técnico local (sin imágenes)"
                  AutomationProperties.Name="Activar el registro técnico local" />
        <TextBlock Style="{StaticResource TextoAyuda}"
                   Text="El registro solo anota eventos y errores. Nunca contiene capturas." />

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" Style="{StaticResource AccionFantasma}"
                    IsCancel="True" Click="Cancel_Click" />
            <Button Content="Guardar" Style="{StaticResource AccionPrimaria}"
                    IsDefault="True" Click="Save_Click" />
        </StackPanel>

    </StackPanel>
</Window>
