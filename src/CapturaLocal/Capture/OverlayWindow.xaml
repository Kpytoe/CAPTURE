<Window x:Class="CapturaLocal.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
      La ventana muestra el recorte congelado de SU monitor. No hay transparencia real:
      se pinta la imagen y encima una capa oscura con un agujero en la seleccion. Eso evita
      depender de AllowsTransparency, que fuerza renderizado por software y arruina el
      objetivo de 500 ms del RNF-01.
    -->
    <Grid x:Name="Root" ClipToBounds="True">
        <Image x:Name="Frozen" Stretch="Fill" />

        <!-- Capa oscura menos la region seleccionada -->
        <Path x:Name="Dimmer" Fill="#88000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="HoleGeometry" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Borde de la seleccion -->
        <Rectangle x:Name="SelectionBorder"
                   Stroke="{StaticResource PincelAcento}" StrokeThickness="1.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Medidas de la region -->
        <Border x:Name="SizeBadge"
                Background="#F21B1B1E" CornerRadius="6" Padding="9,4"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Consolas" />
        </Border>

        <!-- Instruccion inicial, solo en el monitor donde esta el raton -->
        <Border x:Name="Hint"
                Background="#F21B1B1E" CornerRadius="10" Padding="20,14"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Foreground="{StaticResource PincelTexto}" FontSize="14"
                           TextAlignment="Center" Text="Arrastra para elegir una región" />
                <TextBlock Foreground="{StaticResource PincelTextoSuave}" FontSize="12"
                           TextAlignment="Center" Margin="0,5,0,0"
                           Text="Esc o clic derecho para cancelar" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
